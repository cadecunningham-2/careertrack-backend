# Copy this file to client/.env (same folder as package.json).
# Public values are baked into the app at start-up. Do not put secrets here.
# After changing it, restart with:  npx expo start -c

# Option A - real phone on the same Wi-Fi as your computer.
# Use your computer's IPv4 address (run `ipconfig` on Windows).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:3001

# Option B - real phone connected by USB cable (see README, "Android over USB").
# EXPO_PUBLIC_API_BASE_URL=http://localhost:10.13.150.254

# Option C - Android emulator: leave this file out or empty, the app uses 10.0.2.2 automatically.

# Option D - deployed API on Render:
# EXPO_PUBLIC_API_BASE_URL=https://your-api-name.onrender.com
